
name: local-assistant

x-llama-common: &llama-common
  image: local-assistant/llama-cuda:5c8854fd8
  restart: "no"
  gpus: all
  volumes:
    - ./models:/models:ro
  networks:
    - home-net
  ports:
    - "127.0.0.1:8080:8080"
  stop_grace_period: 30s

services:
  core:
    <<: *llama-common
    profiles: ["core"]
    command:
      - --model
      - /models/core/qwen3.5-9b/Qwen_Qwen3.5-9B-Q6_K.gguf
      - --alias
      - qwen3.5-9b-core
      - --host
      - 0.0.0.0
      - --port
      - "8080"
      - --n-gpu-layers
      - "99"
      - --ctx-size
      - "16384"
      - --parallel
      - "1"
      - --reasoning
      - "off"

  unrestricted:
    <<: *llama-common
    profiles: ["unrestricted"]
    command:
      - --model
      - /models/unrestricted/qwen3.5-9b/Qwen3.5-9B-Uncensored-HauhauCS-Aggressive-Q6_K.gguf
      - --alias
      - qwen3.5-9b-unrestricted
      - --host
      - 0.0.0.0
      - --port
      - "8080"
      - --n-gpu-layers
      - "99"
      - --ctx-size
      - "16384"
      - --parallel
      - "1"
      - --reasoning
      - "off"

networks:
  home-net:
    external: true
    name: home-net
